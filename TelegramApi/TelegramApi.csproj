    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
    <PackageReference Include="WolverineFx.FluentValidation" Version="6.51.2" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.31.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TelegramApi.Application\TelegramApi.Application.csproj" />
